{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^7.2",
        "aws/aws-sdk-php": "~3.0",
        "fideloper/proxy": "^4.0",
        "guzzlehttp/guzzle": "^7.5",
        "intervention/image": "^2.7",
        "laravel/framework": "^6.0",
        "laravel/helpers": "^1.6",
        "laravel/tinker": "^1.0",
        "league/flysystem-aws-s3-v3": "^1.0",
        "mpdf/mpdf": "^8.1",
        "phpoffice/phpspreadsheet": "^1.26",
        "ramsey/uuid": "^3.9",
        "spatie/laravel-activitylog": "^3.17",
        "staudenmeir/laravel-upsert": "^1.2",
        "tymon/jwt-auth": "^1.0",
        "xendit/xendit-php": "^2.19"
    },
    "require-dev": {
        "facade/ignition": "^1.4",
        "fzaninotto/faker": "^1.4",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^3.0",
        "phpunit/phpunit": "^8.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "App\\Libraries\\": "src"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "files": [
            "app/Helpers/PerhitunganPPH21Helper.php",
            "app/Helpers/PerhitunganBPJSHelper.php",
            "app/Helpers/GeneratePPH21KaryawanHelper.php",
            "app/Helpers/GenerateXenditHelper.php",
            "app/Helpers/GeneratePaperidHelper.php",
            "app/Helpers/PermissionHelper.php",
            "app/Helpers/MenuHelper.php",
            "app/Helpers/RekkaaHelper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
